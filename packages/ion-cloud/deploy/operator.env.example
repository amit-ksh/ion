# Public origin identifies the real TLS service, NOT the Auth0 audience.
ION_CLOUD_PUBLIC_ORIGIN=https://YOUR-API-HOSTNAME
ION_CLOUD_STATE_DIRECTORY=/var/lib/ion-cloud
ION_CLOUD_PORT=8790
ION_CLOUD_WORKSPACE_LIMIT=64
# Approved Auth0 subjects and roles, not email addresses or passwords.
# File contents: [{"subject":"auth0|REPLACE","role":"owner"}, ...judge entries]
ION_CLOUD_MEMBERS_FILE=/etc/ion-cloud/members.json
# Speech runs locally on each desktop; no hosted STT configuration is needed.
# Separate wildcard content domain, ideally a different registrable domain.
ION_CONTENT_DOMAIN=YOUR-CONTENT-DOMAIN
# Dedicated isolated worker. Omit all hosting-worker fields for HTML/static-only.
ION_HOSTING_WORKER_ORIGIN=https://YOUR-PRIVATE-WORKER-HOSTNAME
ION_HOSTING_WORKER_TOKEN_FILE=/etc/ion-cloud/hosting-worker-token
ION_HOSTING_SECRETS_KEY_FILE=/etc/ion-cloud/hosting-secrets-key
