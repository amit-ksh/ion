{
  "name": "@ion/cloud-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "bun run build && node --test tests/*.test.mjs",
    "deploy:gateway": "wrangler deploy --config wrangler.gateway.jsonc"
  },
  "dependencies": {
    "jose": "6.2.8"
  },
  "devDependencies": {
    "wrangler": "4.151.2",
    "@cloudflare/workers-types": "5.20261019.1",
    "miniflare": "5.20261019.0-beta"
  }
}
