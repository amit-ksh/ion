# Operator-only configuration. Never ship to desktop or phone.
ION_CLOUD_PUBLIC_ORIGIN=https://YOUR-API-HOSTNAME
ION_HOSTING_WORKER_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
ION_HOSTING_STATE_DIRECTORY=/var/lib/ion-hosting
ION_HOSTING_WORKER_PORT=8792
ION_HOSTING_NETWORK=ion-apps
ION_HOSTING_REGISTRY_PROXY_HOST=172.31.0.1
ION_HOSTING_REGISTRY_PROXY_PORT=3128
# Set only after reviewing/installing gVisor, internal networking and firewall.
ION_HOSTING_ISOLATION_READY=gvisor-private-network-v1
# Supply actually verified image digests. Images must include /bin/sh and the
# selected runtime; build image needs npm/bun/pip for its accepted lockfile.
ION_HOSTING_NODE_IMAGE=YOUR-VERIFIED-NODE-IMAGE@sha256:REPLACE
ION_HOSTING_BUN_IMAGE=YOUR-VERIFIED-BUN-IMAGE@sha256:REPLACE
ION_HOSTING_PYTHON_IMAGE=YOUR-VERIFIED-PYTHON-IMAGE@sha256:REPLACE
