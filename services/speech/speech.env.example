# Store the real file as /etc/ion/speech.env, owned by root, mode 0600.
# The launch preflight refuses the placeholder, empty/short values and header injection.
# A speech token is separate from the Nebius Token Factory key.
NEMO_SPEECH_HTTP_API_KEY=replace-with-a-random-service-token
# Choose the actual pinned GGUF path printed by the service user's verified pull.
# An existing local model avoids downloads during service start/restart.
ION_SPEECH_MODEL_PATH=replace-with-an-absolute-verified-GGUF-path
# Optional custom install prefix (absolute, verified executable):
# ION_SPEECH_BINARY=/opt/ion-speech/bin/nemo-speech
# Optional, only with a verified CUDA server build and compatible GPU:
# NEMO_SPEECH_ASR_BACKEND_GPU=0
