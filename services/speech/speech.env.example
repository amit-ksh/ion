# Store the real file as /etc/ion/speech.env, owned by root, mode 0600.
# A speech token is separate from the Nebius Token Factory key.
NEMO_SPEECH_HTTP_API_KEY=replace-with-a-random-service-token
# Optional, only with a verified CUDA server build and compatible GPU:
# NEMO_SPEECH_ASR_BACKEND_GPU=0
