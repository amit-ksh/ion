# Operator Linux host only. Never ship this environment or credentials in Ion.
ION_CLOUD_PUBLIC_ORIGIN=https://api.build-with-ion.tech
ION_COMPUTE_INSTANCE_ID=REPLACE_WITH_EXISTING_COMPUTE_INSTANCE_ID
ION_COMPUTE_CONTROLLER_TOKEN=REPLACE_WITH_PRIVATE_43_TO_128_CHARACTER_RANDOM_TOKEN
ION_NEBIUS_CREDENTIALS_FILE=/etc/ion-operator/nebius-credentials.json
ION_COMPUTE_STATE_DIRECTORY=/var/lib/ion-compute-controller
