[Unit]
Description=Ion operator compute controller
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ion-operator
WorkingDirectory=/opt/ion
EnvironmentFile=/etc/ion-operator/controller.env
ExecStart=/usr/bin/node --experimental-strip-types services/compute-controller/src/main.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ion-compute-controller
[Install]
WantedBy=multi-user.target
