  "narrative": {
    "northStar": "Operate",
    "overview": "Ion is a native workbench: quiet charcoal or warm pale surfaces, compact contextual controls, and a restrained lime signal for the next useful action. Alignment and readable hierarchy do most of the work. Rounded groups hold an object, editor, or composer without turning every region into a card.\n\nDesktop uses GPUI; Android uses React Native and Expo. Their shared palette and vocabulary establish one product while their control sizes and navigation remain native. The independent dotted-stem-and-loop Ion mark is canonical in `assets/icons/ion.svg`; `scripts/assets/ion-icon.py` produces platform assets with lime on charcoal.\n\nThis is a source-extracted record of the implemented redesign, not a visual acceptance record. The session was code led; there is no approved comp. Committed visual evidence is limited to a Windows native dark Teams capture (`docs/ion-redesign/evidence/desktop-teams-dark.png`); the earlier local home capture is not final-build acceptance evidence. Teams supplies narrow runtime proof that its prior hover-registration crash is fixed. Desktop light and broader interaction coverage, Android phone/tablet themes and states, and hardware validation remain incomplete. Formal visual disposition is **recapture**; the seven source findings resolved in `docs/ion-redesign/reviewer-verdict.md` do not establish full parity or visual acceptance. See `docs/ion-redesign/ux-audit.md` for the complete evidence boundary.",
    "keyCharacteristics": [
      "Neutral surfaces with selective lime emphasis.",
      "Compact desktop controls and larger Android touch targets.",
      "Real state, short contextual labels, and nearby actions.",
      "Flat content groups with depth reserved for transient layers.",
      "Visible focus, readable themes, and motion that respects system settings."
    ],
    "rules": [
      {
        "name": "The Intentional Lime Rule",
        "body": "Use filled lime for the contextual primary action and selected brand affordances; keep broad work surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "The Semantic Foreground Rule",
        "body": "Resolve status and accent text from the current theme. Pair meaning with a label or icon, not color alone.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Preserve platform text scaling and existing content font settings; do not replace chrome with a branded display font.",
        "section": "typography"
      },
      {
        "name": "The Flat Content Rule",
        "body": "Establish everyday grouping with surface tone, spacing, and hairlines; reserve cast shadow for floating desktop layers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use neutral layers for broad surfaces and lime for the contextual primary action.",
      "**Do** resolve text, status, and focus colors from the current theme.",
      "**Do** preserve native system typography, platform scaling, and the bundled desktop code face.",
      "**Do** pair status with text or an icon and keep actions keyboard/touch operable.",
      "**Do** retain Android's labelled compact navigation and expanded rail.",
      "**Do** keep real connection, draft, busy, error, approval, and conflict states visible.",
      "**Do** use the canonical Ion vector and reproducible platform assets.",
      "**Do** recapture missing theme, viewport, and interaction evidence before claiming visual acceptance."
    ],
    "donts": [
      "**Don't** spread the primary lime across large canvas regions or use it as light-theme body text.",
      "**Don't** add fictional metrics, decorative charts, stacked glass, or perpetual decorative motion.",
      "**Don't** replace Android's opaque workbench surfaces with a simulated glass treatment.",
      "**Don't** force desktop control geometry onto Android touch controls.",
      "**Don't** treat parent rounding as clipping for GPUI descendant paint.",
      "**Don't** add I/O, whole-session scans, or a new frame clock to a rendering path.",
      "**Don't** claim full desktop/Android parity or hardware validation from source checks or one screenshot."
    ]
  }
}
