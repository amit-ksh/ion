  "components": [
    {
      "name": "Desktop Ticket - Dark",
      "kind": "card",
      "refersTo": "desktop-ticket-dark",
      "description": "Home rail ticket: mono number stub, dashed perforation, title, station and state pill. Rest elevation. Illustrative HTML translation of a native primitive; preview CSS only.",
      "html": "<article class=\"ds-ticket\"><div class=\"ds-stub\"><span>#8CE6</span><span>6d</span></div><hr class=\"ds-perf\"><div class=\"ds-body\"><b>Workflow: QA bounded retry</b><div class=\"ds-meta\"><span>waku</span><span class=\"ds-pill\">Ready</span></div></div></article>",
      "css": ".ds-ticket{font-family:system-ui,sans-serif;width:260px;background:#181d1b;color:#eef2ec;border:1px solid hsla(150,10%,90%,.09);border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,.38),0 6px 18px -4px rgba(0,0,0,.29)} .ds-stub{display:flex;justify-content:space-between;padding:9px 12px 8px;font:11.5px \"JetBrains Mono\",monospace;color:#9da69a} .ds-perf{margin:0 12px;border:0;border-top:1px dashed hsla(150,10%,90%,.09)} .ds-body{padding:9px 12px 12px;display:grid;gap:12px;font-size:13.5px} .ds-body b{font-weight:500} .ds-meta{display:flex;justify-content:space-between;font-size:12px;color:#bac2b7} .ds-pill{height:20px;padding:0 7px;border-radius:999px;font-size:11px;font-weight:500;display:inline-flex;align-items:center;color:#62c987;background:rgba(98,201,135,.14)}"
    },
    {
      "name": "Desktop Ticket Needs You - Light",
      "kind": "card",
      "refersTo": "desktop-ticket-needs-you-light",
      "description": "Lime border, accent-soft stub and the inline Allow/Deny pass. Illustrative HTML translation of a native primitive; preview CSS only.",
      "html": "<article class=\"ds-nt\"><div class=\"ds-nstub\"><span>#D4AD</span><span>Working for 1m 33s</span></div><hr class=\"ds-nperf\"><div class=\"ds-nbody\"><b>Create ion-perm-probe.txt</b><div class=\"ds-pass\"><button class=\"allow\">Allow once</button><button class=\"deny\">Deny</button></div></div></article>",
      "css": ".ds-nt{font-family:system-ui,sans-serif;width:280px;background:#fff;color:#121712;border:1px solid #c2ef68;border-radius:12px;box-shadow:0 1px 2px hsla(150,25%,10%,.072),0 6px 18px -4px hsla(150,25%,10%,.056)} .ds-nstub{display:flex;justify-content:space-between;padding:9px 12px 8px;border-radius:11px 11px 0 0;background:hsla(80,72%,55%,.18);font:11.5px \"JetBrains Mono\",monospace;color:#5a6457} .ds-nperf{margin:0 12px;border:0;border-top:1px dashed hsla(150,8%,12%,.09)} .ds-nbody{padding:9px 12px 12px;display:grid;gap:12px;font-size:13.5px} .ds-nbody b{font-weight:500} .ds-pass{display:flex;gap:8px} .ds-pass button{flex:1;height:30px;border-radius:8px;font:600 12.5px system-ui} .allow{background:#c2ef68;color:#1b2510;border:0} .deny{background:none;border:1px solid hsla(150,8%,12%,.14);color:#465045}"
    },
    {
      "name": "Desktop Filled Menu Chip - Dark",
      "kind": "chip",
      "refersTo": "desktop-menu-chip-filled-dark",
      "description": "MenuChip.filled(): composer model, effort and access selectors. Illustrative HTML translation of a native primitive; preview CSS only.",
      "html": "<button class=\"ds-chip\">GPT-6-Luna</button>",
      "css": ".ds-chip{font-family:system-ui,sans-serif;height:28px;padding:0 10px;border-radius:999px;border:1px solid hsla(150,10%,90%,.075);background:hsla(150,10%,90%,.05);color:#eef2ec;font-size:12.5px;font-weight:500} .ds-chip:hover{background:hsla(150,10%,90%,.09)} .ds-chip:focus-visible{outline:none;border-color:#c2ef68}"
    },
    {
      "name": "Desktop Composer - Dark",
      "kind": "input",
      "refersTo": "desktop-composer-dark",
      "description": "18px composer card with Lifted elevation and a round lime send. Illustrative HTML translation of a native primitive; preview CSS only.",
      "html": "<div class=\"ds-comp\"><div>Do anything... type @ to add files, teams or apps</div><div class=\"ds-row\"><span class=\"ds-c\">Medium</span><button class=\"ds-send\">&#8593;</button></div></div>",
